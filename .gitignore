# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js build output
/.next/
/out/

# Production build
/build

# Environment files (bloquea .env y cualquier variante como .env.local, .env.production)
.env
.env.*
!.env.example

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel & Deployments
.vercel

# Downloads & local temp files
/downloads/

# TypeScript
*.tsbuildinfo
next-env.d.ts